{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "needs": [
      "renderer"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "glnulled-cluster-slot",
      "path": "kit/cluster-slot",
      "title": "Cluster slot for Customizer",
      "description": "Moves cluster-render's panel to slot 0x105, so the widgets and the media list stay on an M-layout cluster while Customizer shows the driving mode; installed with Customizer",
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
